# ResearchPilot Environment Configuration

# App Configuration
APP_NAME=ResearchPilot
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./researchpilot.db

# LLM Configuration (Optional - standard OpenAI-compatible API)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2

# External Search Tools (Optional)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Agent Execution Bounds
MAX_RETRY_COUNT=3
MAX_STEP_COUNT=15
